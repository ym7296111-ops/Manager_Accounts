# ---------------------------------------------------------------------------
# Frontend (Vite). Copy this file to .env.local for local tooling, and mirror
# the same keys in Vercel (Project Settings -> Environment Variables) so the
# production build can resolve them at build time.
# ---------------------------------------------------------------------------

# Supabase project URL (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon/public API key (Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional branding and deployment origin
VITE_APP_NAME="نظام الإدارة"

# Public origin of THIS deployment, without a trailing slash.
#
# This repo is a template: it is deployed to a different domain in every
# environment, so no domain is ever hardcoded in the source.
#
# Password recovery currently uses manual admin approval. The six-digit OTP
# self-service flow and the `/reset-password` link flow are deferred for the
# future until real SMTP is configured (see README.md), so this value is NOT on
# the critical path. It is still used to build the absolute fallback link kept
# as a reference for deployments that enable the emailed `/reset-password` link.
# Leave it empty and the app falls back to window.location.origin, which is
# fine for `vite dev` and for any deployment whose dashboard URL matches the
# origin serving the bundle.
#
# If you keep the link-based fallback enabled, whitelist the matching entry:
# Authentication -> URL Configuration -> Redirect URLs -> <origin>/reset-password
# See the "Authentication Setup" section of README.md.
VITE_APP_URL=https://your-domain.example.com
# Local development instead:
# VITE_APP_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Mail gateway worker (EXECUTION environment ONLY — Deno/Node worker runtime).
# These are runtime secrets/config for sending real mail: never prefix them with
# VITE_ (that ships them into the browser bundle), never commit real values, and
# never mirror them into the frontend project's environment variables.
# ---------------------------------------------------------------------------

# Supabase project URL + service-role key the worker uses for delivery-log access
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# AES-256-GCM master key (Base64, 32 bytes) that wraps SMTP credentials at rest;
# the version label is non-secret and tracks key rotation. Runtime secret only.
MAIL_MASTER_KEY=YOUR_BASE64_32_BYTE_MASTER_KEY
MAIL_MASTER_KEY_VERSION=2026-10

# Egress adapter selection (currently only "smtp"; reserved for "https_api")
MAIL_EGRESS_MODE=smtp

# Synchronous SMTP retry loop inside the worker (no external queue): up to
# MAIL_MAX_SEND_ATTEMPTS (1-5, default 3) attempts spaced by exponential
# backoff MAIL_RETRY_BACKOFF_MS * 2^(n-1) ms (default 250).
MAIL_MAX_SEND_ATTEMPTS=3
MAIL_RETRY_BACKOFF_MS=250

# Optional worker-side SMTP endpoint override — dev sink (Mailpit/Mailhog) or a
# corporate relay. TLS mode, identity, and credentials always come from the
# notification_transports row and its encrypted secret; `tls_mode=none` is
# refused whenever NODE_ENV=production (§1.6 C4).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TIMEOUT_MS=10000
